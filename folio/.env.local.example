# Copy this file to .env.local and fill in your own values.
# .env.local is never committed to git.

# --- Supabase (Project Settings -> API keys) ---
# These two are designed to be public; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server only. Never share or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Finnhub (finnhub.io -> Dashboard) --- SECRET
FINNHUB_API_KEY=

# --- OpenRouter (openrouter.ai -> Keys) --- SECRET
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Email (added at Task 20) --- SECRET
RESEND_API_KEY=

# --- Daily job protection (any long random string) --- SECRET
CRON_SECRET=
