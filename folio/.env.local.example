# Copy this file to .env.local and fill in your own values.
# .env.local is never committed to git.

# --- Supabase (Project Settings -> API keys) ---
# These two are designed to be public; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, local test scripts only (npm run privacy / market-check). Never put it on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub, OpenRouter and email keys are NOT set here: they live in
# Supabase -> Edge Functions -> Secrets, where the server code that uses them runs.
